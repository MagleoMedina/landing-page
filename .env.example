# Variables de entorno para el backend (Spring Boot los lee vía spring.config.import)
# Copia este archivo a .env y completá los valores.

# API key de Resend (https://resend.com) para el envío de correo del formulario de contacto.
# En el plan gratuito, con el remitente por defecto solo podés enviar al correo con el
# que te registraste (usá el mismo que en CONTACT_TO).
RESEND_API_KEY=

# Remitente. Dejar el default usa onboarding@resend.dev (solo a tu propio correo).
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Destinatario de los mensajes de contacto.
CONTACT_TO=tucorreo@gmail.com